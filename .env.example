# Copie para .env local; nunca publique valores reais no GitHub.
NODE_ENV=development
PORT=3000
STORE_PUBLIC_URL=http://localhost:3000
STORE_ID=esex-store
# IPs exatos dos proxies confiáveis, separados por vírgula; vazio ignora X-Forwarded-For.
TRUSTED_PROXY_IPS=
# Alternativa: quantidade fixa de proxies. Use somente atrás de ingresso controlado.
# Não combine com TRUSTED_PROXY_IPS; em acesso direto, deixe zero.
TRUSTED_PROXY_HOPS=0
DATA_DIR=./data

# Bootstrap do primeiro administrador. Não cria nem promove conta já existente.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pagamento: comece com credenciais de TESTE.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Token Melhor Envio com permissão de cotação; ambiente igual ao toggle sandbox.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CONTACT=

# Remetente verificado: confirmação de pedido e autenticação por e-mail.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
