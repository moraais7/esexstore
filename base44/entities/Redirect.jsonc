{
  "name": "Redirect",
  "type": "object",
  "properties": {
    "from_path": {
      "type": "string"
    },
    "to_path": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "from_path",
    "to_path"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}