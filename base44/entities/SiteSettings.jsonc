{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "main"
    },
    "store_name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "announcement": {
      "type": "string"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "whatsapp_message": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "about_short": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "payments_configured": {
      "type": "boolean",
      "default": false
    },
    "payments_note": {
      "type": "string"
    },
    "shipping_configured": {
      "type": "boolean",
      "default": false
    },
    "shipping_note": {
      "type": "string"
    },
    "demo_mode": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}