{
  "name": "Product",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brand": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "visible": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "needs_review": {
      "type": "boolean",
      "default": false
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "composition": {
      "type": "string"
    },
    "care_instructions": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "variant_sku": {
            "type": "string"
          },
          "sort_order": {
            "type": "number"
          }
        }
      }
    },
    "price_from": {
      "type": "number"
    },
    "price_from_promo": {
      "type": "number"
    },
    "total_stock": {
      "type": "number"
    },
    "sku_default": {
      "type": "string"
    },
    "sex": {
      "type": "string"
    },
    "age_range": {
      "type": "string"
    },
    "mpn": {
      "type": "string"
    },
    "cost": {
      "type": "number"
    },
    "physical": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}